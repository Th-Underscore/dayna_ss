  "exchanges": [
    {
      "user_input": "The commander studies the map of the shattered city.",
      "output": "John Jones traces a supply route through the rubble."
    },
    {
      "user_input": "What happened at the Kessler raid?",
      "output": "He goes still, then recounts the night the district burned."
    },
    {
      "user_input": "Tell me about your brother.",
      "output": "His jaw tightens; Paul is not a subject he opens easily."
    },
    {
      "user_input": "Are the Subterraneans advancing?",
      "output": "He nods grimly and taps the map."
    },
    {
      "user_input": "I found a journal in the archive.",
      "output": "He takes it, turning it over in scarred hands."
    },
    {
      "user_input": "The wound is healing, I think.",
      "output": "He flexes his shoulder and grunts."
    },
    {
      "user_input": "Should we trust the new scout?",
      "output": "He watches the horizon for a long moment."
    },
    {
      "user_input": "The city gate is open tonight.",
      "output": "He narrows his eyes at the report."
    },
    {
      "user_input": "Why do you wear that scarf?",
      "output": "He touches the crimson cloth, a private look crossing his face."
    },
    {
      "user_input": "The radio is crackling with a distress call.",
      "output": "He leans in, listening to the static."
    },
    {
      "user_input": "We need more ammunition.",
      "output": "He marks the depot on the map with a short nod."
    },
    {
      "user_input": "The rain is turning to ice.",
      "output": "He pulls his coat tighter and keeps walking."
    },
    {
      "user_input": "There is a traitor in the camp.",
      "output": "His expression hardens to stone."
    },
    {
      "user_input": "How many survived the raid?",
      "output": "He counts silently, then looks away."
    },
    {
      "user_input": "The generators are failing.",
      "output": "He moves to the hatch without a word."
    },
    {
      "user_input": "I saw lights beyond the ridge.",
      "output": "He studies the ridge line through the scope."
    },
    {
      "user_input": "Your orders, commander?",
      "output": "He considers, then gives a single curt command."
    },
    {
      "user_input": "The children found a tunnel.",
      "output": "He orders it sealed and watched."
    },
    {
      "user_input": "Are you alright?",
      "output": "He does not answer, but his hands shake slightly."
    },
    {
      "user_input": "The rebellion holds another week.",
      "output": "He allows himself a thin smile."
    }
  ],
